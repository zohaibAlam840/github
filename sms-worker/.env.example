# Copy to .env. Every value here has a sensible default — the worker runs
# with no .env at all, auto-detecting the modem.

# --- Modem ---------------------------------------------------------------
# Leave COM_PORT unset to auto-detect. The scan skips NMEA/Diagnostic/Audio
# ports (a SIM7600 exposes 4-5 ports and only the AT one works) and then
# qualifies each candidate: SIM present, registered, signal, service centre.
# COM_PORT=COM5
# BAUD_RATE=115200

# Port the dashboard reaches this worker on.
# CONTROL_PORT=3900

# --- TRB141 SMS rules ----------------------------------------------------
# Must match the rules configured on the field devices exactly.
KEYWORD_OPEN=valveon
KEYWORD_CLOSE=valveoff
KEYWORD_STATUS=iostatus

# How a reply is read as a relay state. Bench replies look like
# "Relay - Open" / "Relay - Closed", but the template is editable on the
# device — if a client's units word it differently, change it here rather
# than in code. Matching is case-insensitive substring.
# REPLY_OPEN_PATTERN=open
# REPLY_CLOSED_PATTERN=clos

# --- Numbers -------------------------------------------------------------
# AT+CMGS wants international format, but numbers get typed into the
# dashboard locally ("03401588816"). A local number is rewritten as
# <code> + number without its leading zero. Set to empty to send numbers
# exactly as stored.
DEFAULT_COUNTRY_CODE=+974

# Only needed if AT+CSCA? comes back blank on the SIM — a missing service
# centre makes every send fail silently.
# SMSC=+974...

# --- First-connect verification -----------------------------------------
# A real gateway used to prove the whole chain before the modem is trusted.
# TEST_GATEWAY_SIM=+974...
# TEST_GATEWAY_PASSWORD=

# --- Timing / logging ----------------------------------------------------
# HEALTH_TICK_MS=15000
# SWEEP_INTERVAL_MS=120000
# Every AT line in and out is logged to data/at-log.txt. Set false to stop.
# RAW_LOG=false

# Deletes EVERY message in modem/SIM storage at startup. Off by default: it
# destroys messages this worker never received. A SIM holds only ~20, and
# operator notifications accumulate there permanently because the worker only
# ever deletes messages it read itself. Once storage fills, the network stops
# delivering replies with no error anywhere. Turn this on for ONE start to
# clear a backlog, then unset it.
# PURGE_STORAGE_ON_START=true
